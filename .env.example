# Server runtime
NODE_ENV=production
PORT=3000

# Gemini / AI providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Postgres / Cloud SQL
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Firebase client config
# These values are used by src/lib/firebase.ts via firebase-applet-config.json.
# If you migrate client config to env vars later, document them here as VITE_* vars.

# Legacy / optional values if parts of the app still depend on them
JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
